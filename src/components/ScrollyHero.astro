---
import ShapeWavesLayer from './shape-waves/ShapeWavesLayer.jsx';

const chapters = [
  { number: '00', name: 'Introduction', time: 0.72 },
  { number: '01', name: 'Curiosity', time: 2.65 },
  { number: '02', name: 'Connection', time: 5.15 },
  { number: '03', name: 'Impact', time: 8.35 },
];
---

<section class="story" id="top" data-story aria-labelledby="story-title">
  <div class="story-sticky" data-story-sticky>
    <div class="story-media" data-story-media aria-hidden="true">
      <img
        class="story-poster"
        src="/assets/story/hero-poster.webp"
        alt=""
        width="1600"
        height="900"
        fetchpriority="high"
      />
      <video
        class="story-video"
        data-story-video
        src="/assets/story/hero-story.mp4"
        poster="/assets/story/hero-poster.webp"
        preload="auto"
        muted
        playsinline
        disablepictureinpicture
      ></video>
    </div>

    <div class="story-shade" aria-hidden="true"></div>
    <div class="story-grain" aria-hidden="true"></div>
    <ShapeWavesLayer client:media="(pointer: fine) and (prefers-reduced-motion: no-preference)" />

    <div class="story-frame" aria-hidden="true">
      <p class="story-frame__hint">Move to meet · Scroll to turn the page</p>
      <div class="story-hud">
        <div class="story-hud__chapter">
          <span data-story-number>00 / 03</span>
          <span data-story-name>Introduction</span>
        </div>
        <div class="story-hud__steps" data-story-markers>
          {chapters.map((chapter, index) => (
            <span class:list={[{ 'is-active': index === 0 }]} data-marker={index}></span>
          ))}
        </div>
        <div class="story-hud__signature"><span>MDL</span><span>© 2026</span></div>
      </div>
    </div>
  </div>

  <div class="story-pages" data-story-pages>
    <article class="story-page story-page--intro is-active" data-story-page data-time={chapters[0].time}>
      <div class="story-page__content story-page__content--intro">
        <p class="story-kicker">Morris / Developer & Researcher</p>
        <h1 id="story-title"><span>Build</span><span>With</span><span>Intent.</span></h1>
        <p class="story-lead">让信息成为可以行动的知识。</p>
        <p class="story-summary">
          你好，我是莫东亮。关注信息检索、AI 智能体应用与数据治理，也相信优秀的开发始于对真实问题的理解。
        </p>
        <div class="story-actions">
          <a href="#projects">查看项目 <span aria-hidden="true">↗</span></a>
          <a href="/blog/">阅读博客 <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <aside class="story-note story-note--top">
        <strong>A Curious Mind.</strong>
        <p>移动鼠标与人物相遇，向下滚动翻开我的故事。</p>
      </aside>
    </article>

    <article class="story-page story-page--one" data-story-page data-time={chapters[1].time}>
      <div class="story-page__content story-page__content--left">
        <p class="story-chapter"><span>01</span> Curiosity / Chapter One</p>
        <h2>从好奇出发，<br />把复杂问题拆成<br />第一条可行路径。</h2>
        <p>先理解问题，再选择技术。每一次可靠的实现，都从一个足够具体的问题开始。</p>
      </div>
    </article>

    <article class="story-page story-page--two" data-story-page data-time={chapters[2].time}>
      <div class="story-page__content story-page__content--right">
        <p class="story-chapter"><span>02</span> Connection / Chapter Two</p>
        <h2>让信息、模型与工程，<br />在真实场景里彼此连接。</h2>
        <p>我关注的不只是模型能力，而是信息怎样进入流程、帮助判断，并最终产生行动。</p>
      </div>
    </article>

    <article class="story-page story-page--three" data-story-page data-time={chapters[3].time}>
      <div class="story-page__content story-page__content--right story-page__content--low">
        <p class="story-chapter"><span>03</span> Impact / Chapter Three</p>
        <h2>把每次探索落成可用产品，<br />也沉淀为下一次出发。</h2>
        <p>从原型、系统到持续记录，让短暂的灵感成为能够被验证、复用和继续生长的作品。</p>
        <a class="story-next" href="#about">继续认识我 <span aria-hidden="true">↓</span></a>
      </div>
    </article>
  </div>
</section>

<script>
  const story = document.querySelector<HTMLElement>('[data-story]');

  if (story) {
    const sticky = story.querySelector<HTMLElement>('[data-story-sticky]');
    const media = story.querySelector<HTMLElement>('[data-story-media]');
    const video = story.querySelector<HTMLVideoElement>('[data-story-video]');
    const pages = [...story.querySelectorAll<HTMLElement>('[data-story-page]')];
    const markers = [...story.querySelectorAll<HTMLElement>('[data-marker]')];
    const chapterNumber = story.querySelector<HTMLElement>('[data-story-number]');
    const chapterName = story.querySelector<HTMLElement>('[data-story-name]');
    const header = document.querySelector<HTMLElement>('[data-header]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(pointer: fine)');
    const saveData = Boolean((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData);
    const chapterNames = ['Introduction', 'Curiosity', 'Connection', 'Impact'];
    let activeIndex = -1;
    let frameId = 0;
    let pendingTime = Number(pages[0]?.dataset.time ?? 0.72);
    let lastPointerSeek = 0;
    let resetTimer = 0;

    const clamp = (value: number, min = 0, max = 1) => Math.min(max, Math.max(min, value));

    const setStaticMode = () => {
      story.classList.add('is-static');
      video?.pause();
    };

    const seek = (time: number, withTransition = false) => {
      if (!video || story.classList.contains('is-static')) return;
      pendingTime = clamp(time, 0.05, Math.max(0.05, (video.duration || 10.005) - 0.05));
      if (video.readyState < 1 || Math.abs(video.currentTime - pendingTime) < 0.035) return;
      if (withTransition && media) media.classList.add('is-switching');
      video.currentTime = pendingTime;
    };

    const finishSeek = () => {
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => media?.classList.remove('is-switching'), 70);
    };

    video?.addEventListener('loadedmetadata', () => {
      video.pause();
      seek(pendingTime);
    }, { once: true });
    video?.addEventListener('seeked', finishSeek);
    video?.addEventListener('error', setStaticMode, { once: true });

    const setActivePage = (index: number) => {
      if (index === activeIndex || !pages[index]) return;
      activeIndex = index;
      pages.forEach((page, pageIndex) => page.classList.toggle('is-active', pageIndex === index));
      markers.forEach((marker, markerIndex) => marker.classList.toggle('is-active', markerIndex === index));
      if (chapterNumber) chapterNumber.textContent = `${String(index).padStart(2, '0')} / 03`;
      if (chapterName) chapterName.textContent = chapterNames[index] ?? '';
      seek(Number(pages[index].dataset.time), true);
    };

    const update = () => {
      frameId = 0;
      const storyRect = story.getBoundingClientRect();
      const viewportCenter = window.innerHeight * 0.52;
      let closestIndex = 0;
      let closestDistance = Number.POSITIVE_INFINITY;

      pages.forEach((page, index) => {
        const rect = page.getBoundingClientRect();
        const distance = Math.abs(rect.top + rect.height / 2 - viewportCenter);
        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      setActivePage(closestIndex);
      header?.classList.toggle('is-over-story', storyRect.bottom > 72 && storyRect.top < window.innerHeight);

      if (storyRect.bottom <= 0 || storyRect.top >= window.innerHeight) {
        media?.style.setProperty('--face-x', '0px');
        media?.style.setProperty('--face-y', '0px');
        media?.style.setProperty('--face-rotate-x', '0deg');
        media?.style.setProperty('--face-rotate-y', '0deg');
      }
    };

    const requestUpdate = () => {
      if (!frameId) frameId = window.requestAnimationFrame(update);
    };

    const handlePointerMove = (event: PointerEvent) => {
      if (!sticky || !media || !finePointer.matches || reduceMotion.matches || saveData) return;
      const bounds = sticky.getBoundingClientRect();
      const storyBounds = story.getBoundingClientRect();
      if (storyBounds.bottom <= 0 || storyBounds.top >= window.innerHeight) return;

      const xRatio = clamp((event.clientX - bounds.left) / bounds.width);
      const yRatio = clamp((event.clientY - bounds.top) / bounds.height);
      const x = xRatio - 0.5;
      const y = yRatio - 0.5;
      story.style.setProperty('--pointer-x', `${xRatio * 100}%`);
      story.style.setProperty('--pointer-y', `${yRatio * 100}%`);
      media.style.setProperty('--face-x', `${x * 34}px`);
      media.style.setProperty('--face-y', `${y * 20}px`);
      media.style.setProperty('--face-rotate-x', `${y * -3.2}deg`);
      media.style.setProperty('--face-rotate-y', `${x * 4.8}deg`);

      const now = performance.now();
      if (video && activeIndex >= 0 && now - lastPointerSeek > 72) {
        const baseTime = Number(pages[activeIndex]?.dataset.time ?? 0.72);
        seek(baseTime + x * 0.58 + y * 0.22);
        lastPointerSeek = now;
      }

    };

    const resetPointer = () => {
      media?.style.setProperty('--face-x', '0px');
      media?.style.setProperty('--face-y', '0px');
      media?.style.setProperty('--face-rotate-x', '0deg');
      media?.style.setProperty('--face-rotate-y', '0deg');
      if (activeIndex >= 0) seek(Number(pages[activeIndex]?.dataset.time ?? 0.72));
    };

    if (reduceMotion.matches || saveData) setStaticMode();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
    window.addEventListener('pointermove', handlePointerMove, { passive: true });
    document.documentElement.addEventListener('mouseleave', resetPointer);
    reduceMotion.addEventListener('change', () => window.location.reload());
    update();
  }
</script>

<style is:global>
  html:has(.story) {
    scroll-snap-type: y proximity;
  }

  .story {
    --story-cream: #f4edde;
    --story-dark: #151713;
    position: relative;
    color: var(--story-cream);
    background: var(--story-dark);
  }

  .story-sticky {
    position: sticky;
    z-index: 0;
    top: 0;
    height: 100svh;
    min-height: 650px;
    overflow: hidden;
    isolation: isolate;
    background: #36372f;
  }

  .story-media {
    --face-x: 0px;
    --face-y: 0px;
    --face-rotate-x: 0deg;
    --face-rotate-y: 0deg;
    position: absolute;
    z-index: 0;
    inset: -4%;
    transform: perspective(1200px) translate3d(var(--face-x), var(--face-y), 0)
      rotateX(var(--face-rotate-x)) rotateY(var(--face-rotate-y)) scale(1.08);
    transform-origin: 50% 44%;
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .story-poster,
  .story-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 46%;
    filter: saturate(0.8) contrast(1.05) brightness(0.76);
  }

  .story-video {
    opacity: 1;
    transition: opacity 170ms ease, filter 170ms ease;
  }

  .story-media.is-switching .story-video {
    opacity: 0.28;
    filter: saturate(0.7) contrast(1.02) brightness(0.62) blur(2px);
  }

  .story.is-static .story-video { display: none; }

  .story-shade {
    position: absolute;
    z-index: 2;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(12, 15, 12, 0.76) 0%, rgba(12, 15, 12, 0.16) 35%, transparent 58%, rgba(12, 15, 12, 0.5) 100%),
      linear-gradient(180deg, rgba(8, 10, 8, 0.44) 0%, transparent 24%, transparent 69%, rgba(8, 10, 8, 0.7) 100%),
      radial-gradient(circle at 50% 42%, transparent 18%, rgba(12, 14, 11, 0.38) 100%);
  }

  .story-grain {
    position: absolute;
    z-index: 5;
    inset: 0;
    pointer-events: none;
    opacity: 0.2;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitchTiles'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.32'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
  }

  .story-frame {
    position: absolute;
    z-index: 9;
    inset: 0;
    pointer-events: none;
  }

  .story-frame::before {
    position: absolute;
    inset: 82px 24px 24px;
    border: 1px solid rgba(244, 237, 222, 0.18);
    content: '';
  }

  .story-frame__hint {
    position: absolute;
    top: 104px;
    right: clamp(38px, 5vw, 86px);
    margin: 0;
    color: rgba(244, 237, 222, 0.64);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .story-pages {
    position: relative;
    z-index: 10;
    margin-top: -100svh;
  }

  .story-page {
    position: relative;
    display: grid;
    min-height: 100svh;
    padding: 120px clamp(42px, 6vw, 110px) 116px;
    align-items: center;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    pointer-events: none;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .story-page__content,
  .story-note {
    opacity: 0.12;
    filter: blur(5px);
    transform: translateY(32px);
    transition: opacity 420ms ease, filter 420ms ease, transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .story-page.is-active .story-page__content,
  .story-page.is-active .story-note {
    opacity: 1;
    filter: none;
    transform: translateY(0);
    pointer-events: auto;
  }

  .story-page__content { width: min(40vw, 610px); }

  .story-page__content--intro,
  .story-page__content--left {
    grid-column: 1;
    justify-self: start;
  }

  .story-page__content--right {
    grid-column: 2;
    justify-self: end;
  }

  .story-page__content--low {
    align-self: end;
    margin-bottom: 8vh;
  }

  .story-kicker,
  .story-chapter,
  .story-hud {
    margin: 0;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  .story-page h1 {
    display: flex;
    margin: 18px 0 12px;
    flex-direction: column;
    font-family: 'Bebas Neue', 'Arial Narrow', sans-serif;
    font-size: clamp(82px, 8vw, 150px);
    font-weight: 400;
    line-height: 0.76;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .story-lead {
    margin: 25px 0 0;
    font-family: var(--serif);
    font-size: clamp(18px, 1.6vw, 27px);
    font-weight: 700;
  }

  .story-summary,
  .story-page__content > p:last-of-type {
    max-width: 520px;
    margin: 12px 0 0;
    color: rgba(244, 237, 222, 0.78);
    font-size: 13px;
    line-height: 1.85;
  }

  .story-actions {
    display: flex;
    margin-top: 24px;
    gap: 10px;
  }

  .story-actions a,
  .story-next {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    gap: 18px;
    padding: 0 17px;
    color: var(--story-cream);
    border: 1px solid rgba(244, 237, 222, 0.44);
    border-radius: 999px;
    background: rgba(14, 17, 14, 0.32);
    backdrop-filter: blur(8px);
    font-size: 11px;
    transition: color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .story-actions a:first-child,
  .story-actions a:hover,
  .story-next:hover {
    color: #20231d;
    background: var(--story-cream);
    transform: translateY(-2px);
  }

  .story-note {
    position: absolute;
    top: 22%;
    right: clamp(42px, 6vw, 110px);
    width: min(18vw, 260px);
    text-align: right;
  }

  .story-note strong {
    display: block;
    font-family: 'Bebas Neue', 'Arial Narrow', sans-serif;
    font-size: clamp(27px, 2.3vw, 42px);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .story-note p {
    margin: 10px 0 0;
    color: rgba(244, 237, 222, 0.72);
    font-size: 11px;
    line-height: 1.8;
  }

  .story-chapter {
    display: flex;
    align-items: center;
    gap: 14px;
    color: rgba(244, 237, 222, 0.66);
  }

  .story-chapter span {
    font-family: Georgia, serif;
    font-size: 12px;
    letter-spacing: 0;
  }

  .story-page h2 {
    margin: 18px 0 0;
    font-size: clamp(34px, 3.6vw, 64px);
    font-weight: 700;
    line-height: 1.13;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .story-next { width: fit-content; margin-top: 25px; }

  .story-hud {
    position: absolute;
    right: clamp(40px, 6vw, 110px);
    bottom: 40px;
    left: clamp(40px, 6vw, 110px);
    display: grid;
    align-items: center;
    grid-template-columns: minmax(190px, auto) 1fr auto;
    gap: 30px;
  }

  .story-hud__chapter,
  .story-hud__signature {
    display: flex;
    gap: 12px;
    white-space: nowrap;
  }

  .story-hud__chapter span:last-child,
  .story-hud__signature span:last-child { color: rgba(244, 237, 222, 0.5); }

  .story-hud__steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 7px;
  }

  .story-hud__steps span {
    position: relative;
    height: 2px;
    overflow: hidden;
    background: rgba(244, 237, 222, 0.24);
  }

  .story-hud__steps span::after {
    position: absolute;
    inset: 0;
    content: '';
    background: var(--story-cream);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 320ms ease;
  }

  .story-hud__steps span.is-active::after { transform: scaleX(1); }

  @media (max-width: 820px) {
    .story-sticky { min-height: 580px; }

    .story-media {
      inset: -3%;
      transform: scale(1.07);
    }

    .story-poster,
    .story-video { object-position: 50% center; }

    .story-shade {
      background:
        linear-gradient(180deg, rgba(10, 12, 10, 0.44) 0%, transparent 25%, transparent 48%, rgba(9, 11, 9, 0.88) 100%),
        radial-gradient(circle at 50% 42%, transparent 20%, rgba(10, 12, 10, 0.3) 100%);
    }

    .story-frame::before { inset: 72px 12px 12px; }
    .story-frame__hint,
    .story-note { display: none; }

    .story-page {
      padding: 92px 27px 210px;
      align-items: end;
      grid-template-columns: 1fr;
    }

    .story-page__content,
    .story-page__content--intro,
    .story-page__content--left,
    .story-page__content--right {
      width: 100%;
      grid-column: 1;
      justify-self: stretch;
    }

    .story-page__content--low { align-self: end; margin-bottom: 0; }
    .story-page h1 { font-size: clamp(72px, 22vw, 112px); }
    .story-page h2 { font-size: clamp(31px, 9.2vw, 44px); }
    .story-summary { display: none; }

    .story-hud {
      right: 27px;
      bottom: 34px;
      left: 27px;
      grid-template-columns: 1fr auto;
      gap: 12px 20px;
    }

    .story-hud__steps { grid-row: 2; grid-column: 1 / -1; }
  }

  @media (max-width: 480px) {
    .story-page h1 { font-size: clamp(68px, 21vw, 96px); }
    .story-actions a { min-height: 36px; gap: 10px; padding: 0 13px; font-size: 10px; }
    .story-kicker { font-size: 9px; }
  }

  @media (prefers-reduced-motion: reduce) {
    html:has(.story) { scroll-snap-type: none; }

    .story { overflow: hidden; }

    .story-sticky {
      position: absolute;
      top: 0;
      width: 100%;
      height: 100svh;
    }

    .story-media { inset: 0; transform: none; }
    .story-video,
    .story-frame__hint { display: none; }
    .story-pages { margin-top: 0; }

    .story-page {
      min-height: auto;
      padding-top: 90px;
      padding-bottom: 90px;
      background: rgba(21, 23, 19, 0.92);
    }

    .story-page:first-child {
      min-height: 100svh;
      background: transparent;
    }

    .story-page__content,
    .story-note {
      opacity: 1;
      filter: none;
      transform: none;
    }

    .story-hud { display: none; }
  }
</style>
