---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  embedded?: boolean;
}

const { posts, embedded = false } = Astro.props;
const [featured, ...otherPosts] = posts;
const Heading = embedded ? 'h2' : 'h1';
const PostHeading = embedded ? 'h3' : 'h2';
const formatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const themes = ['研究阅读', '项目实践', '技术探索', '卓越工程师培养项目的建设思考', '工程问题复盘'];
---

<section
  class="section editorial-section journal-section"
  id={embedded ? 'blog' : undefined}
  aria-labelledby="journal-title"
>
  <div class="editorial-light" aria-hidden="true"></div>
  <div class="section-label reveal"><span>{embedded ? '06' : 'Blog'}</span><p>Journal</p></div>
  <div class="editorial-content">
    <header class="journal-header">
      <div class="journal-intro reveal">
        <p class="editorial-eyebrow">Notes & explorations</p>
        <Heading class="editorial-title journal-title" id="journal-title">探索<span class="editorial-accent">手记</span></Heading>
        <p class="journal-description">记录关于信息检索、AI 智能体、数据治理与工程实践的观察、方法和阶段性思考。</p>
      </div>
      <aside class="journal-media reveal" data-delay="1" aria-label="首页影像手记">
        <figure class="editorial-photo journal-photo">
          <img src="/assets/story/about-impact.webp" alt="暖光下身穿米色卫衣、脸上贴着小贴纸的动画人物" width="640" height="360" loading="lazy" decoding="async" />
          <figcaption><span>Morris / In motion</span><span>Home / Story</span></figcaption>
        </figure>
        <p class="editorial-note journal-note">保持好奇，持续记录。<span aria-hidden="true">☆</span></p>
      </aside>
    </header>

    <div class="journal-caption reveal" aria-hidden="true"><span>Opening note</span><span>Writing in progress</span></div>
    <div class="journal-layout">
      <div class="journal-articles" aria-label="文章列表">
        {featured ? (
          <article class="editorial-paper journal-featured reveal">
            <div class="journal-entry-meta">
              <p><span aria-hidden="true">01</span> / 开篇手记</p>
              <i aria-hidden="true"></i>
              <time datetime={featured.data.pubDate.toISOString()}>{formatter.format(featured.data.pubDate)}</time>
            </div>
            <div class="journal-featured-content">
              <figure class="journal-illustration" aria-hidden="true">
                <img src="/assets/blog/journal-book.svg" alt="" width="420" height="360" loading="lazy" decoding="async" />
                <figcaption>Information / Knowledge / Action</figcaption>
              </figure>
              <div class="journal-entry-copy">
                <PostHeading>{featured.data.title}</PostHeading>
                <p>{featured.data.description}</p>
                {featured.data.tags.length > 0 && (
                  <ul class="editorial-tags journal-tags" aria-label="文章主题">
                    {featured.data.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                )}
                <a class="journal-read" href={`/blog/${featured.id}/`} aria-label={`阅读全文：${featured.data.title}`}>阅读全文 <span aria-hidden="true">↗</span></a>
              </div>
            </div>
          </article>
        ) : (
          <p class="journal-empty reveal">文章正在整理中，稍后见。</p>
        )}
        {otherPosts.length > 0 && (
          <div class="journal-other-entries">
            {otherPosts.map((post, index) => (
              <article class="journal-entry reveal">
                <div class="journal-other-meta"><span aria-hidden="true">{String(index + 2).padStart(2, '0')}</span><time datetime={post.data.pubDate.toISOString()}>{formatter.format(post.data.pubDate)}</time></div>
                <div>
                  <PostHeading><a href={`/blog/${post.id}/`}>{post.data.title}<span aria-hidden="true">↗</span></a></PostHeading>
                  <p>{post.data.description}</p>
                </div>
              </article>
            ))}
          </div>
        )}
      </div>
      <aside class="journal-themes reveal" data-delay="1" aria-labelledby="journal-themes-title">
        <PostHeading id="journal-themes-title">这里会记录什么</PostHeading>
        <p class="editorial-eyebrow">Writing themes</p>
        <ul>{themes.map((theme) => <li>{theme}</li>)}</ul>
        <p class="journal-quote">对问题、选择和过程的<br />诚实记录。</p>
      </aside>
    </div>
    {embedded && (
      <div class="editorial-footer journal-footer reveal">
        <a class="journal-more" href="/blog/">查看全部 <span aria-hidden="true">↗</span></a>
        <a class="editorial-next" href="#contact" aria-label="继续查看联系方式">07 / Let’s connect <span aria-hidden="true">↘</span></a>
      </div>
    )}
  </div>
</section>

<style>
  :global(.home-page) .section.journal-section {
    background: radial-gradient(ellipse at 56% 36%, rgba(205, 199, 159, 0.17), transparent 46%), linear-gradient(135deg, #5a5947, #3d3f34);
  }

  .journal-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.56fr);
    align-items: center;
    gap: 40px;
    padding: 0 0 32px;
  }

  .journal-intro,
  .journal-articles,
  .journal-entry-copy { min-width: 0; }

  .journal-section .journal-intro .editorial-title.journal-title {
    margin-top: 18px;
    font-size: clamp(44px, 5.3vw, 84px);
    line-height: 1.3;
  }

  .journal-description {
    max-width: 560px;
    margin-top: 26px;
    font-size: 17px;
    line-height: 1.85;
  }

  .journal-media {
    width: min(100%, 380px);
    padding: 4px 10px 16px;
    justify-self: end;
  }

  .journal-photo {
    box-shadow: none;
    outline: 1px solid rgba(241, 234, 219, 0.5);
    outline-offset: 8px;
  }

  .journal-photo::after { display: none; }
  .journal-note { margin: -4px -14px 0 auto; }

  .journal-caption {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 17px 0 24px;
    border-top: 1px solid rgba(241, 234, 219, 0.36);
    font-family: Georgia, serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .journal-layout {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(210px, 1fr);
    gap: clamp(26px, 3vw, 48px);
    align-items: start;
  }

  .journal-featured { padding: 30px 32px 28px; }

  .journal-featured > * { position: relative; z-index: 1; }

  .journal-featured::after {
    box-shadow: inset 0 0 0 14px rgba(245, 236, 216, 0.4), inset 0 0 0 15px rgba(94, 83, 58, 0.15);
  }

  .journal-entry-meta {
    display: flex;
    align-items: baseline;
    gap: 18px;
    margin-bottom: 24px;
    font-family: var(--serif);
  }

  .journal-entry-meta p { font-size: 19px; white-space: nowrap; }
  .journal-entry-meta p span { font-family: Georgia, serif; font-size: 33px; }
  .journal-entry-meta i { height: 1px; background: rgba(67, 63, 49, 0.4); flex: 1; }
  .journal-entry-meta time { font-size: 11px; letter-spacing: 0.03em; white-space: nowrap; }

  .journal-featured-content {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    gap: 28px;
    align-items: start;
  }

  .journal-illustration {
    padding: 8px 5px 14px;
    background: rgba(204, 177, 119, 0.13);
    align-self: stretch;
  }

  .journal-illustration img { display: block; width: 100%; height: auto; }
  .journal-illustration figcaption { padding: 6px 3px 0; font-family: Georgia, serif; font-size: 8px; letter-spacing: 0.12em; text-align: center; text-transform: uppercase; }
  .journal-entry-copy h2,
  .journal-entry-copy h3 { font-family: var(--serif); font-size: clamp(24px, 2.5vw, 36px); font-weight: 500; line-height: 1.45; letter-spacing: -0.035em; }
  .journal-entry-copy > p { margin-top: 18px; font-size: 15px; line-height: 1.85; }
  .journal-tags { margin-top: 18px; gap: 10px; }
  .journal-tags li { padding: 7px 12px; border-color: rgba(61, 57, 44, 0.5); font-size: 12px; }

  .journal-read {
    display: flex;
    width: fit-content;
    min-height: 44px;
    margin-top: 24px;
    padding: 10px 0 6px;
    border-bottom: 1px solid #c68a32;
    align-items: center;
    gap: 12px;
    font-family: var(--serif);
    font-size: 19px;
  }

  .journal-read span,
  .journal-more span,
  .journal-entry a span { transition: transform 180ms ease; }
  .journal-read:hover span,
  .journal-more:hover span,
  .journal-entry a:hover span { transform: translate(3px, -3px); }
  .journal-read:focus-visible,
  .journal-more:focus-visible,
  .journal-entry a:focus-visible { outline: 1px solid currentColor; outline-offset: 5px; }

  .journal-themes { padding: 20px 0 0 26px; border-left: 1px solid rgba(241, 234, 219, 0.34); }
  .journal-themes h2,
  .journal-themes h3 { font-family: var(--serif); font-size: clamp(23px, 2.2vw, 32px); font-weight: 500; line-height: 1.4; }
  .journal-themes .editorial-eyebrow { margin-top: 10px; }
  .journal-themes ul { margin-top: 24px; }
  .journal-themes li { position: relative; padding: 9px 0 9px 22px; font-size: 15px; line-height: 1.8; }
  .journal-themes li::before { position: absolute; top: 19px; left: 0; width: 6px; height: 6px; border-radius: 50%; background: #d49a43; content: ''; }
  .journal-quote { margin-top: 25px; padding-top: 22px; border-top: 1px solid rgba(241, 234, 219, 0.34); font-family: var(--serif); font-size: 19px; line-height: 1.85; letter-spacing: 0.06em; }
  .journal-empty { padding: 40px 0; font-size: 15px; line-height: 1.85; }
  .journal-other-entries { margin-top: 38px; }
  .journal-entry { display: grid; grid-template-columns: 115px minmax(0, 1fr); gap: 22px; padding: 26px 0; border-bottom: 1px solid rgba(241, 234, 219, 0.34); }
  .journal-other-meta { font-family: Georgia, serif; font-size: 11px; }
  .journal-other-meta > span { display: block; margin-bottom: 12px; font-size: 22px; }
  .journal-entry h2,
  .journal-entry h3 { font-family: var(--serif); font-size: 24px; font-weight: 500; line-height: 1.5; }
  .journal-entry a { display: flex; min-height: 44px; align-items: baseline; justify-content: space-between; gap: 16px; }
  .journal-entry a span { flex-shrink: 0; }
  .journal-entry p { margin-top: 12px; font-size: 15px; line-height: 1.85; }
  .journal-more { display: inline-flex; min-height: 44px; gap: 12px; align-items: center; font-family: var(--serif); font-size: 18px; letter-spacing: 0; }

  @media (max-width: 1100px) {
    .journal-header { grid-template-columns: minmax(0, 1fr) minmax(230px, 0.6fr); gap: 26px; }
    .journal-layout { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .journal-featured-content { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); }
    .journal-themes { padding: 24px 0 0; border-top: 1px solid rgba(241, 234, 219, 0.34); border-left: 0; }
    .journal-themes ul { display: flex; flex-wrap: wrap; gap: 0 24px; margin-top: 15px; }
    .journal-quote { max-width: 460px; font-size: 18px; }
  }

  @media (max-width: 820px) {
    .journal-header { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .journal-section .journal-intro .editorial-title.journal-title { font-size: clamp(44px, 8vw, 66px); }
    .journal-description { margin-top: 20px; font-size: 15px; }
    .journal-media { width: min(100%, 440px); justify-self: center; }
    .journal-caption { padding-top: 16px; }
    .journal-featured { margin: 0 4px; padding: 28px 26px; }
    .journal-featured-content { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .journal-illustration { width: min(100%, 400px); justify-self: center; }
    .journal-entry-copy h2,
    .journal-entry-copy h3 { font-size: 29px; }
    .journal-entry-copy > p { margin-top: 15px; }
    .journal-entry-meta { flex-wrap: wrap; gap: 12px; }
    .journal-entry-meta i { min-width: 25px; }
    .journal-read { margin-top: 22px; }
    .journal-quote br { display: none; }
  }

  @media (max-width: 560px) {
    .journal-section .journal-intro .editorial-title.journal-title { font-size: 46px; }
    .journal-caption { font-size: 8px; letter-spacing: 0.15em; }
    .journal-featured { padding: 24px 20px; }
    .journal-entry-meta p { font-size: 16px; }
    .journal-entry-meta p span { font-size: 28px; }
    .journal-entry-meta time { font-size: 10px; }
    .journal-entry-meta i { display: none; }
    .journal-entry-meta { justify-content: space-between; }
    .journal-entry-copy h2,
    .journal-entry-copy h3 { font-size: 26px; }
    .journal-tags { gap: 8px; }
    .journal-tags li { padding: 6px 9px; }
    .journal-themes ul { display: block; }
    .journal-entry { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .journal-other-meta { display: flex; align-items: baseline; gap: 14px; }
    .journal-other-meta > span { margin-bottom: 0; }
    .journal-entry h2,
    .journal-entry h3 { font-size: 22px; }
    .journal-footer { gap: 12px; }
  }
</style>
