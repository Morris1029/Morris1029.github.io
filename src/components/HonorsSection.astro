---
const recognitions = [
  { title: '国家励志奖学金', detail: '2 次' },
  { title: '中山大学优秀学生奖学金', detail: '2 次' },
  { title: '中山大学优秀共青团干部', detail: '荣誉' },
  { title: '全国信息资源管理案例大赛', detail: '复赛入围' },
  { title: '大学生创新训练项目', detail: '校级优秀结项' },
];
const credentialGroups = [
  { title: '专业认证', items: ['信息系统项目管理师（高级）', 'IBM Product Manager'] },
  { title: '语言能力', items: ['大学英语六级（CET-6）', '普通话二级甲等'] },
];
---

<section class="section honors editorial-section" id="honors" aria-labelledby="honors-title">
  <div class="editorial-light" aria-hidden="true"></div>
  <div class="section-label reveal"><span>05</span><p>Honors</p></div>
  <div class="editorial-content recognition-content">
    <div class="recognition-heading reveal">
      <p class="editorial-eyebrow">Recognition & credentials</p>
      <h2 class="editorial-title" id="honors-title">努力留下的<span class="editorial-accent">注脚</span></h2>
      <p class="editorial-subtitle">记录曾经的努力，也提醒自己继续向前。</p>
    </div>

    <aside class="recognition-media reveal" data-delay="1" aria-label="首页影像手记">
      <figure class="editorial-photo recognition-photo">
        <img src="/assets/story/about-curiosity.webp" alt="暖光下脸上贴着小贴纸的动画人物" width="640" height="360" loading="lazy" decoding="async" />
        <figcaption><span>Morris / In motion</span><span>Home / Story</span></figcaption>
      </figure>
      <p class="editorial-note recognition-note">继续积累，继续向前。<span aria-hidden="true">☆</span></p>
    </aside>

    <div class="recognition-awards reveal">
      <div class="recognition-caption"><h3>荣誉与认可</h3><p>Recognition notes</p></div>
      <ol class="recognition-list">
        {recognitions.map((recognition, index) => (
          <li>
            <span class="recognition-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h4>{recognition.title}</h4>
            <strong class:list={['recognition-value', { 'recognition-value--count': index < 2 }]}>{index < 2 ? <><span>2</span> 次</> : recognition.detail}</strong>
          </li>
        ))}
      </ol>
    </div>

    <div class="editorial-paper recognition-credentials reveal" data-delay="1">
      <svg class="recognition-paperclip" viewBox="0 0 44 68" aria-hidden="true" focusable="false"><path d="M34 10 14 46c-4 7-14 2-10-5L25 6c6-10 21-2 15 8L18 54C9 69-8 58 1 43L22 8" /></svg>
      <h3>专业与语言认证</h3>
      <p class="recognition-card-caption">Credential notes</p>
      {credentialGroups.map((group) => (
        <div class="recognition-group">
          <h4><span>{group.title}</span></h4>
          <ul>
            {group.items.map((credential) => (
              <li>
                <svg viewBox="0 0 28 34" aria-hidden="true" focusable="false"><path d="M4 2h14l6 6v24H4zM18 2v7h6M8 14h11M8 19h11M8 24h7" /></svg>
                <span>{credential}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div class="recognition-book" aria-hidden="true">
        <svg viewBox="0 0 112 64" focusable="false"><path d="M5 22c16-8 31-10 48-4C68 6 83 4 99 8l10 35c-18-4-34 0-49 13C43 46 26 48 8 54zM53 18l7 38M8 54l-4-29M60 56l-2 5c-19-9-34-9-50-4M60 56l3 4c15-12 32-16 47-14" /></svg>
        <p>知识让前路<br />有更多可能。</p>
      </div>
    </div>

    <div class="editorial-footer recognition-footer reveal">
      <span class="editorial-eyebrow">Morris / Notes</span>
      <a class="editorial-next" href="#contact" aria-label="继续查看联系方式">Let’s connect <span aria-hidden="true">↘</span></a>
    </div>
  </div>
</section>

<style>
  .recognition-content {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    align-items: start;
    gap: 38px clamp(28px, 3vw, 50px);
  }

  .recognition-heading {
    padding-top: 22px;
    align-self: center;
  }

  .recognition-heading .editorial-title {
    margin: 18px 0 14px;
  }

  .recognition-media {
    min-width: 0;
    padding-bottom: 18px;
  }

  .recognition-photo {
    margin: 0 12px 0 0;
  }

  .recognition-note {
    position: relative;
    width: max-content;
    max-width: calc(100% - 14px);
    margin: -8px 0 0 auto;
  }

  .recognition-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 20px;
    padding: 20px 0 10px;
    border-top: 1px solid rgba(241, 234, 219, 0.35);
  }

  .recognition-caption h3 {
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 500;
  }

  .recognition-caption p,
  .recognition-card-caption {
    font-family: Georgia, serif;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .recognition-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .recognition-list li {
    display: grid;
    min-height: 82px;
    padding: 17px 0;
    grid-template-columns: 38px minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(12px, 1.3vw, 22px);
    border-bottom: 1px solid rgba(241, 234, 219, 0.35);
  }

  .recognition-index {
    position: relative;
    width: fit-content;
    padding-bottom: 8px;
    font-family: Georgia, serif;
    font-size: 20px;
  }

  .recognition-index::after {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 26px;
    height: 2px;
    border-radius: 50%;
    background: #d49a43;
    transform: rotate(-4deg);
    content: '';
  }

  .recognition-list h4 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(18px, 2vw, 30px);
    font-weight: 500;
    line-height: 1.45;
  }

  .recognition-value {
    min-width: 104px;
    padding: 8px 12px;
    border: 1px solid rgba(241, 234, 219, 0.45);
    border-radius: 2px;
    font-size: 14px;
    font-weight: 400;
    text-align: center;
  }

  .recognition-value--count {
    min-width: 82px;
    padding: 0;
    border: 0;
    font-family: var(--serif);
    font-size: 20px;
    text-align: right;
  }

  .recognition-value--count span {
    font-family: Georgia, serif;
    font-size: 48px;
    font-style: italic;
    line-height: 1;
  }

  .recognition-credentials {
    position: relative;
    margin-top: 16px;
    padding: 34px clamp(24px, 3vw, 42px) 26px;
    box-shadow: inset 0 0 0 1px rgba(61, 57, 44, 0.18), 0 10px 24px rgba(20, 21, 17, 0.2);
  }

  .recognition-credentials h3 {
    font-family: var(--serif);
    font-size: clamp(26px, 2.6vw, 40px);
    font-weight: 500;
    line-height: 1.35;
  }

  .recognition-card-caption {
    margin-top: 5px;
  }

  .recognition-paperclip {
    position: absolute;
    top: -14px;
    right: 24px;
    width: 32px;
    height: 50px;
    fill: none;
    stroke: #76715e;
    stroke-width: 1.7;
    stroke-linecap: round;
    transform: rotate(12deg);
  }

  .recognition-group {
    margin-top: 26px;
  }

  .recognition-group h4 {
    display: flex;
    margin: 0;
    align-items: center;
    gap: 16px;
    font-size: 16px;
    font-weight: 400;
  }

  .recognition-group h4::after {
    height: 1px;
    background: rgba(61, 57, 44, 0.35);
    flex: 1;
    content: '';
  }

  .recognition-group h4 span {
    padding-bottom: 5px;
    border-bottom: 1px solid #c28632;
  }

  .recognition-group ul {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .recognition-group li {
    display: flex;
    padding: 9px 0;
    align-items: center;
    gap: 15px;
    font-family: var(--serif);
    font-size: clamp(15px, 1.5vw, 21px);
    line-height: 1.5;
  }

  .recognition-group li svg {
    width: 22px;
    height: 27px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linejoin: round;
  }

  .recognition-book {
    display: flex;
    margin-top: 22px;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
    transform: rotate(-6deg);
  }

  .recognition-book svg {
    width: 90px;
    height: 52px;
    fill: none;
    stroke: currentColor;
    stroke-width: 0.9;
    stroke-linejoin: round;
  }

  .recognition-book p {
    font-family: var(--serif);
    font-size: 14px;
    line-height: 1.65;
    letter-spacing: 0.08em;
  }

  .recognition-footer {
    grid-column: 1 / -1;
  }

  @media (max-width: 1100px) {
    .recognition-content {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: 30px 28px;
    }

    .recognition-list li {
      grid-template-columns: 30px minmax(0, 1fr) auto;
      gap: 12px;
    }

    .recognition-value {
      min-width: 88px;
      padding: 7px 9px;
      font-size: 12px;
    }

    .recognition-value--count {
      min-width: 66px;
      padding: 0;
      font-size: 18px;
    }
  }

  @media (max-width: 820px) {
    .recognition-content {
      grid-template-columns: minmax(0, 1fr);
      gap: 34px;
    }

    .recognition-heading {
      padding-top: 0;
    }

    .recognition-media {
      width: min(100%, 450px);
      justify-self: center;
      padding-bottom: 0;
    }

    .recognition-credentials {
      margin: 0 6px;
    }

    .recognition-list h4 {
      font-size: 21px;
    }

    .recognition-group li {
      font-size: 17px;
    }
  }

  @media (max-width: 560px) {
    .recognition-list li {
      min-height: 84px;
      grid-template-columns: 25px minmax(0, 1fr) 72px;
      gap: 8px;
    }

    .recognition-index {
      font-size: 17px;
    }

    .recognition-list h4 {
      font-size: 17px;
    }

    .recognition-value {
      min-width: 0;
      padding: 6px 4px;
      font-size: 12px;
    }

    .recognition-value--count {
      padding: 0;
      font-size: 16px;
    }

    .recognition-value--count span {
      font-size: 40px;
    }

    .recognition-credentials {
      padding: 30px 22px 24px;
    }

    .recognition-group li {
      gap: 12px;
      font-size: 15px;
    }
  }
</style>
