---
import BaseLayout from './BaseLayout.astro';

const { title, description, pubDate, updatedDate, tags = [] } = Astro.props;
const formatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title}｜莫东亮`} description={description}>
  <main id="main-content" class="article-shell">
    <article class="article">
      <a class="article-back" href="/blog/">← 返回博客</a>
      <header class="article-header">
        <p class="eyebrow">Notes & explorations</p>
        <h1>{title}</h1>
        <p class="article-description">{description}</p>
        <div class="article-meta">
          <time datetime={pubDate.toISOString()}>发布于 {formatter.format(pubDate)}</time>
          {updatedDate && (
            <time datetime={updatedDate.toISOString()}>更新于 {formatter.format(updatedDate)}</time>
          )}
        </div>
        {tags.length > 0 && (
          <ul class="tag-list" aria-label="文章标签">
            {tags.map((tag: string) => <li>{tag}</li>)}
          </ul>
        )}
      </header>
      <div class="prose">
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>
