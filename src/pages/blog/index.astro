---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogJournal from '../../components/BlogJournal.astro';
import '../../styles/editorial.css';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="博客｜莫东亮"
  description="关于信息检索、AI 智能体、数据治理与工程实践的思考和记录。"
  theme="journal"
>
  <main id="main-content" class="journal-shell">
    <BlogJournal posts={posts} />
  </main>
</BaseLayout>

<style>
  :global(.journal-page .site-header:not(.is-menu-open)) {
    color: var(--home-cream);
    border-color: var(--home-line);
    background: rgba(42, 43, 35, 0.94);
  }

  :global(.journal-page .site-header:not(.is-menu-open) .brand-mark) {
    color: #37372e;
    background: var(--home-cream);
  }

  :global(.journal-page .site-footer) {
    color: var(--home-sage);
    border-top: 1px solid var(--home-line);
    background: #303128;
  }

  .journal-shell {
    padding-top: var(--header-height);
  }
</style>
