---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到｜莫东亮" description="你访问的页面不存在或已经移动。">
  <main id="main-content" class="blog-shell">
    <header class="blog-hero">
      <p class="eyebrow">404 · Not found</p>
      <h1>这里暂时没有内容。</h1>
      <p class="blog-intro">你访问的页面不存在，或已经移动到新的位置。</p>
      <a class="button button-primary" href="/">返回首页</a>
    </header>
  </main>
</BaseLayout>
